PROJECT_NAME           = @PROJECT_NAME@
OUTPUT_DIRECTORY       = @CMAKE_CURRENT_BINARY_DIR@/docs
INPUT                  = @CMAKE_SOURCE_DIR@/src
RECURSIVE              = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = YES

EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_ALL            = YES

# Include Qt macros in parsing
PREDEFINED             = "Q_OBJECT" "signals=protected" "slots=protected"
